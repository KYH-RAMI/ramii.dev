@page "/login"

<PageTitle>Login // ramii.dev</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<div class="min-h-screen bg-[#07090e] text-slate-100 font-mono flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-[#0a0e17] border border-amber-500/30 rounded-lg p-6 sm:p-8 shadow-2xl relative">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-amber-500/20 via-amber-500 to-amber-500/20"></div>

        <!-- Header -->
        <div class="text-center pb-6 border-b border-amber-500/10 mb-6">
            <span class="text-amber-500 font-bold text-xl tracking-wider block">[>_ ramii.dev]</span>
            <span class="text-xs text-slate-400 mt-1 block">Säker administratörsinloggning</span>
        </div>

        @if (HasError)
        {
            <div class="mb-4 p-3 bg-red-950/50 border border-red-500/60 rounded text-red-300 text-xs flex items-center gap-2">
                <span class="text-red-500 font-bold">!</span>
                <span>Fel användarnamn eller lösenord.</span>
            </div>
        }

        <!-- Formulär som postar direkt till vår säkra Cookie-endpoint -->
        <form method="post" action="/api/auth/login" class="space-y-4">
            <div>
                <label class="block text-xs text-slate-400 mb-1">>_ Användarnamn</label>
                <input type="text" name="username" required autocomplete="username"
                       class="w-full bg-[#07090e] border border-amber-500/30 rounded px-3 py-2 text-sm text-slate-100 focus:outline-none focus:border-amber-500 transition"
                       placeholder="" />
            </div>

            <div>
                <label class="block text-xs text-slate-400 mb-1">>_ Lösenord</label>
                <input type="password" name="password" required autocomplete="current-password"
                       class="w-full bg-[#07090e] border border-amber-500/30 rounded px-3 py-2 text-sm text-slate-100 focus:outline-none focus:border-amber-500 transition"
                       placeholder="" />
            </div>

            <button type="submit"
                    class="w-full mt-2 py-2.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs rounded transition flex items-center justify-center gap-2">
                <span>[ Logga in ]</span>
            </button>
        </form>

        <div class="mt-6 pt-4 border-t border-white/5 text-center">
            <a href="/" class="text-xs text-slate-500 hover:text-amber-400 transition">
                ← Tillbaka till publika sajten
            </a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? error { get; set; }

    private bool HasError => error == "invalid";
}
