@* Components/Sections/HeroSection.razor *@

<section id="hero" class="w-full py-12 lg:py-20 px-4 sm:px-6 lg:px-8 bg-page">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-center">
        
        <!-- VÄNSTER: INTRO, BIO & KNAPPAR -->
        <div class="flex flex-col space-y-6">
            
            <!-- HELLO WORLD med blinkande underscore -->
            <div class="text-xs font-mono tracking-widest text-amber-accent uppercase">
                HELLO WORLD<span class="terminal-cursor">_</span>
            </div>

            <!-- Rami Issa med terminal utskrift -->
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-heading font-mono">
                <span class="typewriter-name">Rami Issa</span>
            </h1>


            <div>
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded border border-amber-accent/40 bg-amber-accent/10 text-amber-accent font-mono text-xs">
                    <svg class="w-3.5 h-3.5 text-amber-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    <span>DevSecOps-student på KYH</span>
                </span>
            </div>

            <p class="text-body text-sm sm:text-base leading-relaxed max-w-xl font-sans">
                Jag studerar DevSecOps på KYH med ett stort intresse för cybersäkerhet,
                Linux och säker systemutveckling. På ramii.dev delar jag min tekniska
                utveckling, egna projekt och erfarenheter från utbildningen.
                Min ambition är att arbeta med säkerhet som en integrerad del av hela
                utvecklingsprocessen.
            </p>

            <p class="text-body text-sm sm:text-base leading-relaxed max-w-xl font-sans">
                Jag söker LIA inom DevSecOps och IT-säkerhet från november 2027.
                Jag vill omsätta mina kunskaper i praktiken, bidra till teamets arbete
                och utvecklas i en professionell miljö.
            </p>

            <!-- Knappar -->
            <div class="flex flex-wrap items-center gap-4 pt-2">
                <a href="#labbar"
                   class="px-5 py-2.5 rounded-md border border-amber-accent/50 bg-surface text-heading font-mono text-xs sm:text-sm font-medium hover:border-amber-accent hover:bg-amber-accent/10 transition-colors flex items-center gap-2">
                    <span>Utforska Labbet</span>
                    <span class="text-amber-accent">&rarr;</span>
                </a>
                <a href="#kontakt"
                   class="px-5 py-2.5 rounded-md border border-border-subtle bg-surface/50 text-body font-mono text-xs sm:text-sm font-medium hover:border-amber-accent/40 hover:text-heading transition-colors">
                    Ta Kontakt
                </a>
            </div>

        </div>

        <!-- HÖGER: TERMINALFÖNSTER -->
        <div class="terminal-window w-full rounded-xl overflow-hidden border border-border-strong shadow-2xl">
            
            <!-- Din godkända topplist med knappar till höger -->
            <div class="terminal-header px-4 py-2.5 flex items-center justify-between text-xs font-mono select-none">
                
                <!-- Prompt-flik till vänster -->
                <div class="flex items-center gap-2 text-heading font-semibold tracking-wide">
                    <span class="text-amber-accent font-bold">&gt;_</span>
                    <span>ramii@@devbox:~</span>
                    <span class="text-meta ml-1 text-[11px] hidden sm:inline">(bash)</span>
                </div>

                <!-- Window controls till höger -->
                <div class="flex items-center gap-3 text-meta">
                    <button type="button" class="hover:text-amber-accent transition-colors p-1" title="Sök">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </button>
                    <button type="button" class="hover:text-amber-accent transition-colors p-1" title="Minimera">
                        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M5 12h14v2H5z" />
                        </svg>
                    </button>
                    <button type="button" class="hover:text-amber-accent transition-colors p-1" title="Maximera">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <rect x="5" y="5" width="14" height="14" rx="1" stroke-width="2" />
                        </svg>
                    </button>
                    <button type="button" class="hover:text-red-400 transition-colors p-1" title="Stäng">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

            </div>

            <!-- Terminalens innehåll -->
            <div class="p-4 sm:p-5 font-mono text-xs leading-relaxed space-y-4 select-text">
                
                <!-- docker ps med format-flagga (ingen scroll) -->
                <div>
                    <div class="text-meta">
                        <span class="text-red-400">┌──[</span><span class="text-amber-accent font-semibold">ramii@@devbox</span><span class="text-red-400">]─[</span><span class="text-heading">~</span><span class="text-red-400">]</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-meta">
                        <span class="text-red-400">└──$</span>
                        <span class="text-heading font-medium">docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"</span>
                    </div>

                    <div class="mt-2">
                        <table class="w-full text-left font-mono text-[11px] leading-tight border-collapse">
                            <thead>
                                <tr class="text-meta font-semibold">
                                    <th class="pr-3 pb-1">NAMES</th>
                                    <th class="pr-3 pb-1">STATUS</th>
                                    <th class="pb-1">PORTS</th>
                                </tr>
                            </thead>
                            <tbody class="text-heading">
                                <tr>
                                    <td class="pr-3 py-0.5 text-amber-accent font-medium whitespace-nowrap">portfolio-web</td>
                                    <td class="pr-3 py-0.5 text-emerald-400/90 whitespace-nowrap">Up 2 hours</td>
                                    <td class="py-0.5 text-meta whitespace-nowrap">0.0.0.0:7010-&gt;8080/tcp</td>
                                </tr>
                                <tr>
                                    <td class="pr-3 py-0.5 text-amber-accent font-medium whitespace-nowrap">mssql-core</td>
                                    <td class="pr-3 py-0.5 text-emerald-400/90 whitespace-nowrap">Up 5 hours (healthy)</td>
                                    <td class="py-0.5 text-meta whitespace-nowrap">0.0.0.0:1433-&gt;1433/tcp</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>


                <!-- Aktiv prompt med blinkande markör -->
                <div>
                    <div class="text-meta">
                        <span class="text-red-400">┌──[</span><span class="text-amber-accent font-semibold">ramii@@devbox</span><span class="text-red-400">]─[</span><span class="text-heading">~</span><span class="text-red-400">]</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-meta">
                        <span class="text-red-400">└──$</span>
                        <span class="inline-block w-2 h-3.5 bg-amber-accent animate-pulse align-middle ml-1"></span>
                    </div>
                </div>

            </div>


        </div>

    </div>
</section>
