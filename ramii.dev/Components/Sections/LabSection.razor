@* Components/Sections/LabSection.razor *@

<section id="labbar" class="w-full py-16 px-4 sm:px-6 lg:px-8 bg-page border-t border-border-subtle/40">
    <div class="max-w-7xl mx-auto space-y-8">
        
        <!-- Sektionsrubrik -->
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div class="space-y-2">
                <div class="text-xs font-mono tracking-widest text-amber-accent uppercase">
                    // LABB & KURSER
                </div>
                <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-heading font-sans">
                    Projekt och labbar
                </h2>
                <p class="text-body text-sm sm:text-base max-w-2xl font-sans">
                    Jag har precis avslutat min tredje kurs, Databashantering SQL. Nästa kurs är Agila metoder och kravhantering.
                </p>
            </div>

            <a href="https://github.com/KYH-RAMI"
               target="_blank"
               rel="noopener noreferrer"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-md border border-border-subtle bg-surface hover:border-amber-accent/50 text-meta hover:text-heading text-xs font-mono transition-colors self-start sm:self-auto">
                <span>Se alla repon på GitHub</span>
                <span class="text-amber-accent">→</span>
            </a>
        </div>

        <!-- Grid med hybridkorten (A + B) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

            <!-- KORT 1: ramii.dev // Backstage & Internsystem -->
            <div class="bg-card border border-border-subtle rounded-xl overflow-hidden hover:border-border-strong transition-all flex flex-col justify-between">
                
                <!-- Topplist (Från A) -->
                <div class="px-4 py-2.5 bg-surface/80 border-b border-border-subtle flex items-center justify-between text-xs font-mono select-none">
                    <div class="flex items-center gap-2">
                        <div class="flex items-center gap-1.5">
                            <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
                            <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
                        </div>
                        <span class="text-meta ml-1 text-[11px]">~/projects/ramii-backstage/</span>
                    </div>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded text-[11px] font-mono border border-emerald-500/30 bg-emerald-500/10 text-emerald-400">
                        Portföljprojekt
                    </span>
                </div>

                <!-- Kortkropp -->
                <div class="p-5 sm:p-6 space-y-4 flex-1 flex flex-col justify-between">
                    <div class="space-y-2">
                        <h3 class="text-lg sm:text-xl font-bold text-heading font-sans">
                            ramii.dev // Backstage & Internsystem
                        </h3>
                        <p class="text-sm text-body leading-relaxed font-sans">
                            Eget kontakt- och ärendehanteringssystem med separat skyddad adminvy, cookie-autentisering och isolerad databasåtkomst via DbContextFactory.
                        </p>
                    </div>

                    <!-- Spec-ruta (Från B) -->
                    <div class="p-3.5 rounded-lg bg-surface border border-border-subtle font-mono text-xs grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                        <div class="flex items-center justify-between sm:justify-start gap-2">
                            <span class="text-meta">ARCH:</span>
                            <span class="text-heading font-medium">Core / Data / Web</span>
                        </div>
                        <div class="flex items-center justify-between sm:justify-start gap-2">
                            <span class="text-meta">AUTH:</span>
                            <span class="text-heading font-medium">ASP.NET Cookie (HttpOnly)</span>
                        </div>
                        <div class="flex items-center justify-between sm:justify-start gap-2">
                            <span class="text-meta">DATA:</span>
                            <span class="text-heading font-medium">EF Core 11 + SQL Server</span>
                        </div>
                        <div class="flex items-center justify-between sm:justify-start gap-2">
                            <span class="text-meta">RUNTIME:</span>
                            <span class="text-heading font-medium">.NET 11 &bull; Blazor Server</span>
                        </div>
                    </div>

                    <!-- Footer: Taggar & Terminal Actions -->
                    <div class="pt-2 flex flex-wrap items-center justify-between gap-3 border-t border-border-subtle/40">
                        <div class="flex flex-wrap gap-1.5">
                            <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-surface border border-border-subtle text-meta">#csharp</span>
                            <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-surface border border-border-subtle text-meta">#dotnet11</span>
                            <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-surface border border-border-subtle text-meta">#blazor</span>
                            <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-surface border border-border-subtle text-meta">#mssql</span>
                        </div>
                        <div class="flex items-center gap-3 font-mono text-xs">
                            <a href="https://github.com/KYH-RAMI" target="_blank" rel="noopener noreferrer" class="text-amber-accent hover:underline flex items-center gap-1 font-medium">
                                &gt;_ code &nearr;
                            </a>
                        </div>
                    </div>
                </div>

            </div>

            <!-- KORT 2: T-SQL och databasdesign -->
            <div class="bg-card border border-border-subtle rounded-xl overflow-hidden hover:border-border-strong transition-all flex flex-col justify-between">
                
                <!-- Topplist (Från A) -->
                <div class="px-4 py-2.5 bg-surface/80 border-b border-border-subtle flex items-center justify-between text-xs font-mono select-none">
                    <div class="flex items-center gap-2">
                        <div class="flex items-center gap-1.5">
                            <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
                            <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
                        </div>
                        <span class="text-meta ml-1 text-[11px]">~/labs/sql-database-design/</span>
                    </div>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded text-[11px] font-mono border border-amber-accent/30 bg-amber-accent/10 text-amber-accent">
                        SQL-labb
                    </span>
                </div>

                <!-- Kortkropp -->
                <div class="p-5 sm:p-6 space-y-4 flex-1 flex flex-col justify-between">
                    <div class="space-y-2">
                        <h3 class="text-lg sm:text-xl font-bold text-heading font-sans">
                            T-SQL och databasdesign
                        </h3>
                        <p class="text-sm text-body leading-relaxed font-sans">
                            Här samlar jag SQL-övningar från kursen Databashantering SQL. Jag använder dem för att träna på grunderna i SQL och databasdesign.
                        </p>
                    </div>

                    <!-- Footer: Taggar & Terminal Actions -->
                    <div class="pt-2 flex flex-wrap items-center justify-between gap-3 border-t border-border-subtle/40">
                        <div class="flex flex-wrap gap-1.5">
                            <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-surface border border-border-subtle text-meta">#t-sql</span>
                            <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-surface border border-border-subtle text-meta">#mssql</span>
                            <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-surface border border-border-subtle text-meta">#indexing</span>
                            <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-surface border border-border-subtle text-meta">#database</span>
                        </div>
                        <div class="flex items-center gap-3 font-mono text-xs">
                            <a href="https://github.com/KYH-RAMI/SQL" target="_blank" rel="noopener noreferrer" class="text-amber-accent hover:underline flex items-center gap-1 font-medium">
                                &gt;_ kurslabb &nearr;
                            </a>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>
</section>
