@inherits LayoutComponentBase
@using ramii.dev.Core.Entities
@using ramii.dev.Services
@inject IBackstageOperations Backstage

<div class="min-h-screen bg-[var(--color-bg)] text-[var(--color-body)] font-mono flex flex-col md:flex-row">
    <!-- Vänstermeny / Sidebar -->
    <aside class="w-full md:w-64 bg-[var(--color-card)] border-b md:border-b-0 md:border-r border-[var(--color-border)] flex flex-col p-4 shrink-0">
        <!-- Logo & Status -->
        <div class="pb-6 border-b border-[var(--color-border)]">
            <div class="text-[var(--color-amber)] font-bold text-lg tracking-wider flex items-center gap-2">
                <span>[>_ ramii.dev]</span>
            </div>
            <div class="flex items-center gap-2 mt-2 text-xs text-[var(--color-meta)]">
                <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>backstage // admin</span>
            </div>
        </div>

        <!-- Navigation -->
        <nav class="mt-6 flex flex-col gap-1.5 flex-1">
            <!-- Ärenden / Inbox med Alert-logik -->
            <a href="/backstage"
               class="@GetInboxClass()">
                <div class="flex items-center gap-2 truncate">
                    @if (unreadCount > 0)
                    {
                        <span class="inline-block w-1.5 h-1.5 rounded-full bg-red-500 animate-ping shrink-0"></span>
                        <span class="font-bold text-red-300 truncate">🚨 Inkorgen</span>
                    }
                    else
                    {
                        <span class="truncate">📁 Inkorgen</span>
                    }
                </div>

                <div class="flex items-center gap-1.5 shrink-0 font-mono text-[11px]">
                    @if (unreadCount > 0)
                    {
                        <span class="px-1.5 py-0.5 rounded bg-red-500 text-slate-950 font-bold">
                            @unreadCount NY
                        </span>
                    }
                    <span class="px-1.5 py-0.5 rounded bg-white/5 text-[var(--color-meta)]">
                        @totalCount
                    </span>
                </div>
            </a>


            <!-- Lab Projects -->
            <NavLink href="/backstage/labbar" class="flex items-center gap-2 px-3 py-2 text-xs rounded text-[var(--color-meta)] hover:text-[var(--color-heading)] hover:bg-[var(--color-surface)] transition">
                <span>🧪</span>
                <span>Lab Projects</span>
            </NavLink>

            <!-- Status & Loggar -->
            <NavLink href="/backstage/status" class="flex items-center gap-2 px-3 py-2 text-xs rounded text-[var(--color-meta)] hover:text-[var(--color-heading)] hover:bg-[var(--color-surface)] transition">
                <span>⚡</span>
                <span>Status & Loggar</span>
            </NavLink>

            <!-- Administratörer -->
            <NavLink href="/backstage/admins" class="flex items-center gap-2 px-3 py-2 text-xs rounded text-[var(--color-meta)] hover:text-[var(--color-heading)] hover:bg-[var(--color-surface)] transition">
                <span>🛡️</span>
                <span>Administratörer</span>
            </NavLink>
        </nav>

        <!-- Botten: Tillbaka till sajten & Logga ut -->
        <div class="pt-4 border-t border-[var(--color-border)] mt-auto flex items-center justify-between text-xs">
            <a href="/" class="text-[var(--color-meta)] hover:text-[var(--color-amber)] transition">
                ← Sajten
            </a>
            <form method="post" action="/api/auth/logout">
                <AntiforgeryToken />

                <button type="submit" 
                    class="text-red-400/80 hover:text-red-400 transition cursor-pointer">
                    [ Logga ut ]
                </button>
            </form>
        </div>
    </aside>

    <!-- Huvudinnehåll -->
    <main class="flex-1 p-4 md:p-8 overflow-y-auto">
        @Body
    </main>
</div>

@code {
    private int totalCount = 0;
    private int unreadCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await RefreshCounts();
    }

    private async Task RefreshCounts()
    {
        try
        {
            var threads = await Backstage.GetThreadsAsync();
            totalCount = threads.Count;
            unreadCount = threads.Count(t => t.Status == ThreadStatus.New);
        }
        catch
        {
            totalCount = 0;
            unreadCount = 0;
        }
    }
    private string GetInboxClass() =>
    unreadCount > 0
        ? "flex items-center justify-between px-3 py-2 rounded text-xs transition bg-red-950/40 text-red-400 border border-red-500/60 shadow-[0_0_12px_rgba(239,68,68,0.2)] animate-pulse"
        : "flex items-center justify-between px-3 py-2 rounded text-xs transition text-[var(--color-meta)] hover:text-[var(--color-heading)] hover:bg-[var(--color-surface)] border border-transparent";

}
