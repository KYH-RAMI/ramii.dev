        <!-- Vänster: Logotyp -->
        <a href="/" class="flex items-center gap-2 group">
            <span class="text-amber-500 font-mono text-base sm:text-lg font-bold tracking-tight group-hover:text-amber-400 transition-colors">
                [&gt;_ ramii.dev]
            </span>
            <span class="inline-block w-2 h-4 bg-amber-500 animate-pulse"></span>
        </a>

